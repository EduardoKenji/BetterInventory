# Runtime and generated contract bytes must be reproducible across Windows and
# Unix checkouts. The bundle manifest and release ZIP hash actual LF bytes.
*.lua text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mod text eol=lf
*.zip binary
*.png binary
